# --- 基础配置 ---
# 敏感值必须在运行时从受控 secret provider 注入；本文件仅保留占位符。
ENV=test
AUTO_DB_URI_TEST=sqlite:///data/local_db/search_ops_automation_test.db
AUTO_DB_URI_PROD=sqlite:///data/local_db/auto_production.db
AUTO_DB_URI=sqlite:///data/local_db/search_ops_automation_test.db
SECRET_KEY=replace-with-a-random-production-secret
INITIAL_ADMIN_PASSWORD=<from-controlled-secret-provider>
ASSISTANT_BOOTSTRAP_JSON={"brandSpaces":[{"brand":"atlas","displayName":"ATLAS"}],"adminUsernames":["admin"]}
PI_AGENT_COMMAND=pi
PI_AGENT_MODEL=gpt-5.6-sol
PI_AGENT_MODELS=gpt-5.6-sol
PI_AGENT_WORKDIR=.
PI_AGENT_SESSION_DIR=.pi/assistant-sessions
PI_AGENT_TIMEOUT_SECONDS=120
PI_WEB_URL=http://127.0.0.1:30141

# --- 运营平台接口 (用于商品拉黑/降权) ---
TEST_BASE_URL=http://staging.example.test
PROD_BASE_URL=http://search.example.test
HEALTH_CHECK_API_URL=http://api:8000/api/health

# --- Query 看板共享只读缓存 ---
# URL 由受控 Secret 注入；留空时应用回退到进程内缓存。
AIOPS_REDIS_URL=
AIOPS_REDIS_KEY_PREFIX=aiops
AIOPS_REDIS_CONNECT_TIMEOUT_SECONDS=1.0
AIOPS_REDIS_SOCKET_TIMEOUT_SECONDS=1.0
ATLAS_API_KEY=<from-controlled-secret-provider>
HARBOR_API_KEY=<from-controlled-secret-provider>
RIVIERA_API_KEY=<from-controlled-secret-provider>
LUMEN_API_KEY=<from-controlled-secret-provider>

# --- 飞书通知 ---
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# --- 治理安全上限 ---
MAX_DAILY_ADJUSTMENTS=100

# --- 本地/自建 LLM 配置 (报告等其他模型调用) ---
LOCAL_LLM_BASE_URL=http://192.168.x.x:3000/v1
LOCAL_LLM_API_KEY=<from-controlled-secret-provider>

# --- 远程 RD-LLM 配置 ---
RD_LLM_BASE_URL=https://api-hub.example.test/v1
RD_LLM_API_KEY=<from-controlled-secret-provider>

# --- Query 治理 Langfuse 可观测性 ---
# Public/Secret Key 通过 K8S Secret 注入；地址和采样参数可由部署配置覆盖。
LANGFUSE_PUBLIC_KEY=<from-controlled-secret-provider>
LANGFUSE_SECRET_KEY=<from-controlled-secret-provider>
LANGFUSE_BASE_URL=http://langfuse.example.test
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=test
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_FLUSH_AT=20
LANGFUSE_FLUSH_INTERVAL=5

# --- Top Query 相关性商品图片 COS（本地 .env 或运行时 Secret 注入） ---
QUERY_GOVERNANCE_COS_REGION=ap-shanghai
QUERY_GOVERNANCE_COS_BUCKET=searchops-ops-data-example
QUERY_GOVERNANCE_COS_PUBLIC_BASE_URL=https://searchops-ops-data-example.cos.ap-shanghai.myqcloud.com
QUERY_GOVERNANCE_COS_KEY_PREFIX=query-governance/images/test/v1
# Optional dedicated HTTP(S) proxy for product image downloads. Inject only at runtime.
QUERY_GOVERNANCE_IMAGE_PROXY_URL=
TENCENT_COS_SECRET_ID=<from-controlled-secret-provider>
TENCENT_COS_SECRET_KEY=<from-controlled-secret-provider>

OPS_TEAM_LLM_IN_TEST=false
OPS_TEAM_DEFAULT_MODEL=MiniMax-M2.5
OPS_TEAM_DEFAULT_FALLBACK_MODEL=qwen3.7-max
OPS_TEAM_MARKET_MODEL=MiniMax-M2.5
OPS_TEAM_PRICE_MODEL=MiniMax-M2.5
OPS_TEAM_UX_MODEL=MiniMax-M2.5
OPS_TEAM_BRAND_MODEL=MiniMax-M2.5
OPS_TEAM_LEADER_MODEL=MiniMax-M2.5
OPS_TEAM_EXPERT_MAX_COMPLETION_TOKENS=4200
OPS_TEAM_LEADER_MAX_COMPLETION_TOKENS=1600
OPS_TEAM_AGENT_TIMEOUT_SECONDS=55
OPS_TEAM_LEADER_TIMEOUT_SECONDS=35
OPS_TEAM_EXPERT_CONCURRENCY=2
OPS_TEAM_BRAND_VISION_ENABLED=true
OPS_TEAM_BRAND_VISION_MAX_PRODUCTS=3
OPS_TEAM_MARKET_RSS_URLS=https://www.vogue.com/feed/rss,https://fashionunited.com/rss/news
OPS_TEAM_ATLAS_BRAND_URLS=https://www.atlas.example.test/cn/,https://www.atlas.com/cn/zh/woman-new-in-l1180.html

# --- 生产环境数据源 (RDS) ---
RD_RDS_USER=readonly_user
RD_RDS_PASS=your_password
RD_RDS_HOST=rds-host.example.com
RD_RDS_PORT=3306
RD_RDS_DB=search_data

# --- AI 召回率检测商品目录数据源（可选）---
# 未配置时自动复用上面的 RD_RDS_*（同一只读实例，ety_standard_product
# 所在库）；仅在目录库与取词库分离时才需要完整配置以下变量。
# PRODUCT_DB_HOST=
# PRODUCT_DB_PORT=3306
# PRODUCT_DB_USER=
# PRODUCT_DB_PASSWORD=
# PRODUCT_DB_NAME=search-ops-admin

# --- Riviera 专用数据源 ---
RD_RIVIERA_USER=riviera_user
RD_RIVIERA_PASS=your_password
RD_RIVIERA_HOST=riviera-host.example.com
RD_RIVIERA_PORT=3306
RD_RIVIERA_DB=riviera_search_data

# --- Summit 专用配置 ---
# OAuth Basic Auth Token (clientId:clientSecret)
SUMMIT_OAUTH_TOKEN=<from-controlled-secret-provider>
# Atlas 商品详情接口运行时标识
ATLAS_WECHAT_APP_ID=<from-controlled-secret-provider>
# Admin Domains
SUMMIT_TEST_BASE_URL=https://summit-admin.pp.example.test
SUMMIT_PROD_BASE_URL=https://summit-admin.example.test
OPS_EMAIL_MODE=simulate
OPS_SUPERVISOR_EMAIL=ops@example.test
